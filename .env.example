# Postgres of the OpenMU server (docker network of the game server: host "database")
DATABASE_URL=postgresql://postgres:CHANGE_ME@database:5432/openmu
# Admin panel API (X-Api-Key, role Viewer) for the live status and online players
GAMESERVER_URL=http://nginx-80
GAMESERVER_API_KEY=
# Folder of the game server's HallOfFame/hall-of-fame.json (raid clears, boss kills)
HALL_FILE=/data/hall/hall-of-fame.json
NEXT_PUBLIC_DISCORD_LINK=https://discord.gg/
NEXT_PUBLIC_DOWNLOAD_URL=https://mu-zylo.com/client/launcher/
